{
  "name": "dsh-cluster-ui",
  "version": "1.1.1",
  "private": true,
  "description": "DSH 前端插件：把 cluster（多机 Agent 集群）的主机/agent 状态、Router 对话、工作区同步搬进 DeepSeek Harness 的设置页与主面板。Router 走真实 LLM 会话（cluster-router preset + 4 个 cluster_* 工具），确定性指令仍走规则快路径。",
  "keywords": ["dsh", "deepseek-harness", "cluster", "router", "multi-agent"],
  "license": "MIT",
  "author": "ku-lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ku-lin/cluster.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/ku-lin/cluster/tree/main/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/ku-lin/cluster/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  }
}
